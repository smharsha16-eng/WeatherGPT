# ==============================================================================
# WeatherGPT Environment Configuration (Example Template)
# ==============================================================================

# 1. WeatherAPI.com Key (Real-time weather + 7-day forecast + AQI)
# Sign up free: https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=your_weatherapi_key_here

# 2. Google Maps Platform API Key
# Console: https://console.cloud.google.com/google/maps-apis/credentials
# Demo Key: https://mapsplatform.google.com/maps-demo-key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. Google Gemini API Key (Conversational AI Chatbot)
# Free Key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 4. OpenRouter API Key (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
